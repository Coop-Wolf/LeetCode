class Solution {
public:
    int reverse(int x) {
        
        long y = 0;

        while(x != 0)
        { 
            y *= 10;
            y += x % 10;
            x /= 10;
        }

        // Return Results
        if(y > INT_MAX) return 0;
        if(y< INT_MIN) return 0;
        return int(y);

    }
};