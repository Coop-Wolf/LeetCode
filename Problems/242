class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        
        if len(s) != len(t):
            return False

        for c in s:
            if t == "":
                return False
            
            if c in t:
                t = t.replace(c, "", 1)
            else:
                return False

        if t == "":
            return True